# --- База данных (контейнер из docker-compose.yml) ---
POSTGRES_USER=prefferance
# Сгенерируй свой: `openssl rand -hex 16`. Не оставляй дефолтный пароль.
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=prefferance
POSTGRES_PORT=5433

DATABASE_URL="postgresql://prefferance:CHANGE_ME_strong_password@127.0.0.1:5433/prefferance?schema=public"

# --- Приложение ---
PORT=3005
# Публичный адрес, по которому друзья открывают игру (нужен для ссылки-приглашения
# и secure-cookie). Если рядом лежат certs/cert.pem + certs/key.pem, сервер слушает HTTPS.
APP_URL="http://localhost:3005"
# Пути к TLS-сертификату (по умолчанию certs/cert.pem и certs/key.pem). Не обязателен.
#HTTPS_CERT=certs/cert.pem
#HTTPS_KEY=certs/key.pem

# --- Безопасность ---
# Секрет для подписи cookie-сессий. Обязателен. Сгенерировать: `openssl rand -hex 32`.
SESSION_SECRET=CHANGE_ME_openssl_rand_hex_32

# --- Реплики за столом ---
# `off` — компьютер молчит в чате. По умолчанию болтает с шансом 0,7 на подходящий расклад.
#PF_TABLE_TALK=off
# Фиксированная пауза перед репликой (мс) — для смоуков; по умолчанию 1,2–2,8 с случайно.
#PF_TABLE_TALK_MS=0
